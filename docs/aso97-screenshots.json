  "market": {
    "category": "Posture awareness and practice",
    "audience": "Desk workers with compatible AirPods who want a short daily posture practice",
    "problem": "Remembering to check posture is difficult during a busy day",
    "advantage": "Short guided AirPods practice, streaks and manual check-ins make the habit concrete",
    "competitive_context": "Posture tools often focus on all-day correction. This app starts with a short practice and leaves monitoring optional",
    "search_intent": ["posture coach", "airpods posture", "slouch alerts"],
    "proof_points": [
      {
        "claim": "Practice starts at three minutes and progresses through levels",
        "source": "../Posture/Views/PracticeSessionView.swift"
      },
      {
        "claim": "Manual check-ins are available without AirPods",
        "source": "../Posture/Views/TodayView.swift"
      }
    ]
  },
