    "Deep breathing expands your ribcage, so inhale tall, exhale relaxed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefes Atmen weitet den Brustkorb, also einatmen und aufrichten, ausatmen und entspannen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar hondo abre la caja torácica: inhala erguido, exhala relajado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirer profondément ouvre la cage thoracique : inspire en te grandissant, expire en te détendant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirare a fondo apre la gabbia toracica: inspira stando dritto, espira rilassato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深い呼吸で胸郭が広がります。吸いながら伸びて、吐きながらゆるめましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diep ademen opent je ribbenkast, dus adem in en strek je, adem uit en ontspan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głęboki oddech rozszerza klatkę piersiową: wdech i wyprostowanie, wydech i rozluźnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirar fundo expande a caixa torácica: inspire crescendo, expire relaxando."
          }
        }
      }
    },
