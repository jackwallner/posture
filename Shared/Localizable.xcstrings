    "Drifting, lift your gaze off the pavement." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sinkst ab, heb den Blick vom Boden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te hundes, levanta la mirada del suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu te relâches, lève les yeux du trottoir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai calando, alza lo sguardo dal marciapiede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "崩れています。視線を足元から上げましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zakt in, kijk op van de stoep."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opadasz, oderwij wzrok od chodnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está cedendo, tire os olhos da calçada."
          }
        }
      }
    },
    "Drop your shoulders on an exhale. This relaxed-tall is your baseline." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Schultern beim Ausatmen sinken. Diese entspannte Aufrichtung ist deine Referenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja los hombros al exhalar. Esta postura erguida y relajada es tu referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse tomber les épaules en expirant. Cette posture droite et détendue est ta référence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa le spalle mentre espiri. Questa postura dritta e rilassata è il tuo riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "息を吐きながら肩を下ろします。このリラックスして伸びた姿勢があなたの基準です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je schouders zakken bij het uitademen. Deze ontspannen rechte houding is je referentie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opuść barki przy wydechu. Ta rozluźniona, prosta postawa to twój punkt odniesienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte os ombros ao expirar. Esta postura ereta e relaxada é sua referência."
          }
        }
      }
    },
    "Earned a streak save." : {
