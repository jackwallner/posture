    "Roll your shoulders back and down 5 times to reset your posture." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreise deine Schultern 5-mal nach hinten und unten, um deine Haltung neu auszurichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roll your shoulders back and down 5 times to reset your posture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira los hombros hacia atrás y hacia abajo 5 veces para reajustar tu postura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruota le spalle indietro e verso il basso 5 volte per ritrovare la postura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩を後ろから下へ5回回して、姿勢を整えましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rol je schouders 5 keer naar achteren en omlaag om je houding te herstellen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пять раз отведи плечи назад и вниз, чтобы выровнять осанку."
          }
        }
      }
    },
    "Roll your shoulders down and back. Chest open, chin level." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roll deine Schultern nach unten und hinten. Brust offen, Kinn gerade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roll your shoulders down and back. Chest open, chin level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva los hombros hacia abajo y hacia atrás. Abre el pecho y mantén el mentón nivelado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta le spalle in basso e indietro. Petto aperto, mento parallelo al suolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩を下げて後ろに回しましょう。胸を開き、あごを水平に。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rol je schouders omlaag en naar achteren. Borst open, kin recht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опусти плечи и отведи их назад. Расправь грудь, держи подбородок ровно."
          }
        }
      }
    },
