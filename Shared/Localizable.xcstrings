    "Roll your shoulders back and down 5 times to reset your posture." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roll die Schultern 5-mal nach hinten unten, um deine Haltung neu auszurichten."
          }
