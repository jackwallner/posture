    "Custom lengths keep your streak. Level progress needs the level's own length." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eigene Dauer hält deine Serie. Fürs Level zählt nur die Leveldauer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las duraciones personalizadas mantienen tu racha. Para progresar de nivel hace falta la duración del nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une durée perso garde ta série. Pour progresser, il faut la durée du niveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le durate personalizzate mantengono la serie. Per salire di livello serve la durata del livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム時間でも連続記録は続きます。レベルを進めるにはレベル本来の時間が必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eigen duur houdt je reeks. Voor niveauvoortgang telt alleen de duur van het niveau."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własna długość podtrzymuje serię. Do postępu poziomu liczy się długość poziomu."
