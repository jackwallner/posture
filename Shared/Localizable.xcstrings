    "One reminder a day for your posture practice, a few minutes held tall with live AirPods coaching. Finishing it keeps your streak." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tägliche Erinnerung an deine Haltungsübung: ein paar Minuten aufrecht mit Live-Coaching über AirPods. Schließe sie ab, um deine Serie zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
