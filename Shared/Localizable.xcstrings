          }
        }
      }
    },
    "Your AirPods record your aligned posture in a few steady seconds." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine AirPods erfassen deine aufrechte Haltung in wenigen ruhigen Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your AirPods record your aligned posture in a few steady seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus AirPods registran tu postura alineada en unos segundos sin moverte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli AirPods registrano la tua postura allineata in pochi secondi, mentre resti fermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
