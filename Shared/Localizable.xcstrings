        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calienta con unas retracciones del mentón y luego pasa %#@n@ sentado con buena postura y los AirPods puestos. El anillo muestra tu alineación en tiempo real y te avisa si te desvías."
          },
          "substitutions" : {
