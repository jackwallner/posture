    "Drifting a little, lift the crown of your head." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sinkst etwas ab, heb den Scheitel an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te hundes un poco, eleva la coronilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu te relâches un peu, grandis-toi par le sommet du crâne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai calando un po’, solleva la sommità della testa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し崩れています。頭のてっぺんを引き上げましょう。"
