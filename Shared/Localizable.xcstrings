    "Drifting a little, lift the crown of your head." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sinkst etwas ein. Heb den Scheitel an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drifting a little, lift the crown of your head."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te desvías un poco. Eleva la coronilla."
