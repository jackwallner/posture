    "We need compatible AirPods." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst kompatible AirPods."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need compatible AirPods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos unos AirPods compatibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono AirPods compatibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するAirPodsが必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt geschikte AirPods nodig."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужны совместимые AirPods."
          }
        }
      }
    },
    "We use the head-motion sensor in your AirPods to read posture. Make sure they're connected to this iPhone. iOS will ask permission to read motion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir nutzen den Kopfbewegungssensor deiner AirPods, um deine Haltung zu erfassen. Stelle sicher, dass sie mit diesem iPhone verbunden sind. iOS fragt nach deiner Erlaubnis, Bewegungsdaten zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use the head-motion sensor in your AirPods to read posture. Make sure they're connected to this iPhone. iOS will ask permission to read motion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos el sensor de movimiento de la cabeza de tus AirPods para leer tu postura. Comprueba que estén conectados a este iPhone. iOS te pedirá permiso para acceder al movimiento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiamo il sensore di movimento della testa degli AirPods per rilevare la postura. Assicurati che siano connessi a questo iPhone. iOS ti chiederà il permesso di accedere ai dati di movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsの頭の動きを捉えるセンサーで姿勢を読み取ります。AirPodsがこのiPhoneに接続されていることを確認してください。iOSからモーションへのアクセス許可を求められます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We gebruiken de hoofdbewegingssensor in je AirPods om je houding te meten. Zorg dat ze verbonden zijn met deze iPhone. iOS vraagt toestemming om beweging te meten."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы используем датчик движения головы в AirPods, чтобы отслеживать осанку. Убедись, что они подключены к этому iPhone. iOS запросит доступ к данным о движении."
          }
        }
      }
    },
    "We'll capture both, but coaching leans where you need it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen beides, aber das Coaching konzentriert sich auf das, was du mehr brauchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll capture both, but coaching leans where you need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registraremos ambas, pero la guía se centrará donde más la necesites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rileveremo entrambe, ma la guida si concentrerà su ciò di cui hai più bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を記録し、必要なほうを中心にコーチングします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We meten beide, maar richten de coaching op wat jij nodig hebt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы запишем оба положения, но уделим больше внимания тому, что тебе нужнее."
          }
        }
      }
    },
    "We've learned your tall posture standing and sitting, and your slouch in each. Every reading is scored against your own range for that posture." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben deine aufrechte Haltung im Stehen und Sitzen erfasst und wie du in beiden Positionen zusammensackst. Jeder Messwert wird anhand deiner persönlichen Spanne für die jeweilige Position bewertet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We've learned your tall posture standing and sitting, and your slouch in each. Every reading is scored against your own range for that posture."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos registrado tu postura erguida y encorvada, tanto de pie como sentado. Cada lectura se puntúa según tu rango personal para esa postura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo rilevato la tua postura dritta in piedi e da seduto, e quella incurvata in entrambe le posizioni. Ogni rilevazione è valutata in base al tuo intervallo personale per quella posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ったときと座ったときの背筋を伸ばした姿勢と、それぞれの猫背を記録しました。各計測値は、その姿勢に応じたあなた自身の範囲を基準に評価されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben vastgelegd hoe je rechtop staat en zit en hoe je in beide houdingen inzakt. Elke meting wordt beoordeeld aan de hand van je eigen bereik voor die houding."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы запомнили твою ровную осанку и сутулость стоя и сидя. Каждое измерение оценивается по твоему диапазону для этого положения."
          }
        }
      }
    },
