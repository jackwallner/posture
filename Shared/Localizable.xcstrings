    "A daily posture practice, coached by your AirPods. A few minutes held tall each day, with live feedback, that's how posture actually changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tägliche Haltungsübung, gecoacht von deinen AirPods. Jeden Tag ein paar Minuten aufrecht, mit Live-Feedback: So verändert sich Haltung wirklich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una práctica diaria de postura, guiada por tus AirPods. Unos minutos erguido cada día, con feedback en directo: así es como cambia de verdad la postura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pratique quotidienne de la posture, coachée par tes AirPods. Quelques minutes droit chaque jour, avec un retour en direct : c’est comme ça que la posture change vraiment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pratica quotidiana per la postura, guidata dai tuoi AirPods. Pochi minuti dritto ogni giorno, con feedback in tempo reale: è così che la postura cambia davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsがコーチする毎日の姿勢練習。リアルタイムのフィードバックを受けながら毎日数分背筋を伸ばす。それが姿勢を本当に変える方法です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een dagelijkse houdingsoefening, gecoacht door je AirPods. Elke dag een paar minuten rechtop, met live feedback: zo verandert houding echt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codzienne ćwiczenie postawy prowadzone przez twoje AirPods. Kilka minut prosto każdego dnia, z informacją zwrotną na żywo: tak naprawdę zmienia się postawa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma prática diária de postura, guiada pelos seus AirPods. Poucos minutos ereto todo dia, com feedback ao vivo: é assim que a postura realmente muda."
          }
        }
      }
    },
