    },
    "Your Apple Watch quietly tracks posture in the background and haptic-nudges you when you slouch. Open Posture on your Watch to begin, and your phone keeps it in sync from there." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Apple Watch misst im Hintergrund leise deine Haltung und vibriert, wenn du zusammensackst. Öffne Posture auf deiner Watch, um zu starten, dein iPhone hält sie danach synchron."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Apple Watch registra tu postura en segundo plano en silencio y vibra cuando te encorvas. Abre Posture en tu Watch para empezar; tu iPhone lo mantiene sincronizado desde ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Apple Watch suit discrètement ta posture en arrière-plan et vibre quand tu t’avachis. Ouvre Posture sur ta Watch pour commencer, ton iPhone la garde synchronisée ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo Apple Watch segue la tua postura in background in silenzio e vibra quando ti ingobbisci. Apri Posture sul Watch per iniziare, poi l’iPhone lo tiene sincronizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchがバックグラウンドで静かに姿勢を見守り、猫背になると振動でお知らせします。WatchでPostureを開けば開始され、その後はiPhoneが同期を保ちます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Apple Watch volgt je houding stil op de achtergrond en trilt als je onderuitzakt. Open Posture op je Watch om te beginnen, daarna houdt je iPhone het gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój Apple Watch po cichu śledzi postawę w tle i wibruje, gdy się garbisz. Otwórz Posture na Watch, aby zacząć; iPhone potem wszystko synchronizuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Apple Watch acompanha sua postura em segundo plano em silêncio e vibra quando você se curva. Abra o Posture no Watch para começar; o iPhone mantém tudo sincronizado depois."
          }
        }
      }
