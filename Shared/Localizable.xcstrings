    "Gently draw your chin straight back, like a small double chin, then return to level. Slow and easy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh dein Kinn sanft gerade zurück, als würdest du ein kleines Doppelkinn machen. Komm dann zurück in die Ausgangsposition. Langsam und locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gently draw your chin straight back, like a small double chin, then return to level. Slow and easy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva suavemente el mentón hacia atrás, como si hicieras un poco de papada, y vuelve a la posición inicial. Sin prisa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta delicatamente il mento indietro, come per fare un piccolo doppio mento, poi torna alla posizione iniziale. Con calma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽く二重あごを作るように、あごをまっすぐ後ろに引き、元の位置に戻します。ゆっくり無理なく行いましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek je kin rustig recht naar achteren, alsof je een kleine dubbele kin maakt, en breng je hoofd weer terug. Langzaam en ontspannen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плавно отведи подбородок назад, словно создаёшь небольшой второй подбородок, затем верни в исходное положение. Не спеши."
          }
        }
      }
    },
    "Get AirPods for the full experience." : {
