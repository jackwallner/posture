    "You can keep it, but a stiller hold gives more honest coaching. Re-settle and redo if you can." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Ergebnis behalten, aber wenn du ruhiger hältst, wird das Coaching genauer. Richte dich neu aus und versuch es noch einmal, wenn möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep it, but a stiller hold gives more honest coaching. Re-settle and redo if you can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes conservarlo, pero mantenerte más quieto permite una guía más precisa. Ponte en posición y repítelo si puedes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi mantenerla, ma restare più fermo permette una guida più precisa. Se puoi, rimettiti in posizione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このままでも使えますが、静止するとより正確なコーチングにつながります。できれば姿勢を整えてやり直しましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit behouden, maar als je stiller blijft, krijg je betrouwbaardere coaching. Ga opnieuw goed zitten of staan en probeer het nog eens als dat lukt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно оставить как есть, но неподвижное положение поможет точнее оценивать осанку. Если можешь, устройся поудобнее и повтори."
          }
        }
      }
    },
