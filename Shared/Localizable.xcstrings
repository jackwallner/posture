    "Curled forward. Ears back over shoulders." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach vorn zusammengesackt. Bring deine Ohren zurück über die Schultern."
