    "Set your screen at eye level to prevent forward head tilt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell deinen Bildschirm auf Augenhöhe, damit sich dein Kopf nicht nach vorn neigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set your screen at eye level to prevent forward head tilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca la pantalla a la altura de los ojos para evitar inclinar la cabeza hacia delante."
          }
