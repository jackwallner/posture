          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods запишут твою ровную осанку за несколько секунд неподвижности."
          }
        }
      }
    },
    "Your Apple Watch quietly tracks posture and taps you when you drift." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Apple Watch erfasst unauffällig deine Haltung und tippt dich an, wenn du davon abweichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple Watch quietly tracks posture and taps you when you drift."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Apple Watch sigue tu postura en silencio y te avisa con un toque cuando pierdes la alineación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch monitora la postura con discrezione e ti avvisa con un tocco quando perdi l'allineamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchが姿勢を静かに記録し、崩れたときにタップでお知らせします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Apple Watch volgt ongemerkt je houding en geeft een tikje als je inzakt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch незаметно отслеживают осанку и подают сигнал, когда ты начинаешь сутулиться."
          }
        }
      }
    },
    "Your Apple Watch quietly tracks posture in the background and haptic-nudges you when you slouch. Open Posture on your Watch to begin, and your phone keeps it in sync from there." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Apple Watch erfasst unauffällig deine Haltung im Hintergrund und tippt dich an, wenn du zusammensackst. Öffne Posture auf deiner Apple Watch, um zu beginnen. Dein iPhone hält danach alles synchron."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple Watch quietly tracks posture in the background and haptic-nudges you when you slouch. Open Posture on your Watch to begin, and your phone keeps it in sync from there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Apple Watch sigue tu postura en segundo plano y te avisa con un toque cuando te encorvas. Abre Posture en tu Apple Watch para empezar y tu iPhone lo mantendrá sincronizado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch monitora la postura in background e ti avvisa con un tocco quando ti incurvi. Per iniziare, apri Posture su Apple Watch. Da quel momento, l'iPhone mantiene tutto sincronizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchがバックグラウンドで姿勢を静かに記録し、猫背になると振動でお知らせします。Apple WatchでPostureを開いて始めると、以降はiPhoneと同期されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Apple Watch volgt op de achtergrond ongemerkt je houding en geeft een tikje als je inzakt. Open Posture op je Apple Watch om te beginnen. Je telefoon houdt alles daarna gesynchroniseerd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch незаметно отслеживают осанку в фоне и подают тактильный сигнал, когда ты сутулишься. Для начала открой Posture на часах, а телефон будет синхронизировать данные."
          }
        }
      }
    },
