        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua prática diária é grátis para sempre. Teste o programa completo por 7 dias e desbloqueie todos os níveis, tendências mais detalhadas, o modo caminhada e avisos opcionais em segundo plano."
          }
        }
