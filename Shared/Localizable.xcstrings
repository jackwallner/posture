    "Get moving and stand tall. The 30-second capture begins when the count ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh los und richte dich auf. Die 30-sekündige Erfassung beginnt nach dem Countdown."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get moving and stand tall. The 30-second capture begins when the count ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte en marcha y mantente erguido. La medición de 30 segundos empieza al terminar la cuenta atrás."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a camminare e tieniti dritto. La rilevazione di 30 secondi inizia alla fine del conto alla rovescia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩き始めて背筋を伸ばしましょう。カウント終了後、30秒間の計測が始まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
