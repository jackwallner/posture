    "Deep breathing expands your ribcage, so inhale tall, exhale relaxed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim tiefen Atmen weitet sich dein Brustkorb. Atme aufrecht ein und entspannt aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep breathing expands your ribcage, so inhale tall, exhale relaxed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al respirar profundamente se expande la caja torácica. Inspira erguido y espira con calma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
