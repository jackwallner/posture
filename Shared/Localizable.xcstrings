    "You've stopped moving. The clock keeps running, but standing still counts as rest - keep walking." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bewegst dich nicht mehr. Die Zeit läuft weiter, aber Stillstehen zählt als Pause. Geh weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've stopped moving. The clock keeps running, but standing still counts as rest - keep walking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te has detenido. El tiempo sigue corriendo, pero estar quieto cuenta como descanso. Sigue caminando."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti sei fermato. Il tempo continua a scorrere, ma stare fermi conta come riposo. Continua a camminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きが止まりました。時間は進みますが、立ち止まると休憩として記録されます。歩き続けましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je staat stil. De klok loopt door, maar stilstaan telt als rust. Blijf lopen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты остановился. Время идёт, но стоять на месте считается отдыхом. Продолжай идти."
          }
        }
      }
    },
    "Your AirPods coach each short session, and your streak grows with every day you show up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine AirPods begleiten jede kurze Einheit, und mit jedem aktiven Tag wächst deine Serie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your AirPods coach each short session, and your streak grows with every day you show up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus AirPods te guían en cada breve sesión y tu racha crece cada día que practicas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli AirPods ti guidano in ogni breve sessione e la tua serie cresce ogni giorno che ti eserciti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
