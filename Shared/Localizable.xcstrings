    "Green means aligned, amber means drifting, coral means slouching. Your AirPods read it about 25 times a second." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grün bedeutet aufrecht, Gelb leicht gebeugt und Korallrot zusammengesackt. Deine AirPods erfassen deine Haltung etwa 25-mal pro Sekunde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green means aligned, amber means drifting, coral means slouching. Your AirPods read it about 25 times a second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde significa alineado, ámbar indica una desviación y coral, que te encorvas. Tus AirPods lo miden unas 25 veces por segundo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde significa allineato, ambra fuori allineamento e corallo incurvato. Gli AirPods rilevano la postura circa 25 volte al secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑は姿勢が整った状態、黄色は崩れ気味、コーラル色は猫背を示します。AirPodsが毎秒約25回読み取ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groen betekent rechtop, oranje betekent iets ingezakt en koraal betekent ingezakt. Je AirPods meten dit ongeveer 25 keer per seconde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зелёный цвет означает ровную осанку, янтарный указывает на небольшое отклонение, а коралловый сигнализирует о сутулости. AirPods считывают положение около 25 раз в секунду."
          }
        }
      }
    },
