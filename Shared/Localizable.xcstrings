            "value" : "Relâche-toi vraiment, menton vers la poitrine, épaules vers l’avant. Regarde l’anneau basculer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciati andare davvero, mento verso il petto, spalle in avanti. Guarda l’anello cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかり力を抜いて、あごを胸に、肩を前に。リングが切り替わるのを見てください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat echt los, kin naar je borst, schouders naar voren. Zie de ring omslaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprawdę odpuść, broda do klatki, barki do przodu. Zobacz, jak zmienia się pierścień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte de verdade, queixo no peito, ombros para a frente. Veja o anel mudar."
          }
        }
      }
    },
