    "We couldn't read that pose. Try a redo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten diese Haltung nicht messen. Versuch es noch mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos leer esa postura. Prueba a repetirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On n’a pas pu mesurer cette posture. Refais-la."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a rilevare questa postura. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姿勢を読み取れませんでした。もう一度お試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden die houding niet meten. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać tej pozycji. Spróbuj ją powtórzyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos ler essa postura. Tente refazer."
          }
        }
      }
    },
    "We need compatible AirPods." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir brauchen kompatible AirPods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitamos unos AirPods compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut des AirPods compatibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono AirPods compatibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するAirPodsが必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben compatibele AirPods nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrzebne są zgodne AirPods."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisamos de AirPods compatíveis."
          }
        }
      }
    },
    "We use the head-motion sensor in your AirPods to read posture. Make sure they're connected to this iPhone. iOS will ask permission to read motion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir messen deine Haltung mit dem Kopfbewegungssensor deiner AirPods. Achte darauf, dass sie mit diesem iPhone verbunden sind. iOS fragt nach Zugriff auf Bewegungsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos el sensor de movimiento de la cabeza de tus AirPods para leer la postura. Asegúrate de que estén conectados a este iPhone. iOS te pedirá permiso para leer el movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On utilise le capteur de mouvement de la tête de tes AirPods pour mesurer ta posture. Vérifie qu’ils sont connectés à cet iPhone. iOS te demandera l’autorisation d’accéder aux mouvements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usiamo il sensore di movimento della testa dei tuoi AirPods per leggere la postura. Assicurati che siano collegati a questo iPhone. iOS ti chiederà il permesso di leggere il movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsのヘッドモーションセンサーで姿勢を読み取ります。このiPhoneに接続されているか確認してください。iOSからモーションの読み取り許可を求められます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We gebruiken de hoofdbewegingssensor in je AirPods om je houding te meten. Zorg dat ze met deze iPhone zijn verbonden. iOS vraagt toestemming om beweging te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do odczytu postawy używamy czujnika ruchu głowy w twoich AirPods. Upewnij się, że są połączone z tym iPhone’em. iOS poprosi o zgodę na odczyt ruchu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos o sensor de movimento da cabeça dos seus AirPods para ler a postura. Confira se eles estão conectados a este iPhone. O iOS vai pedir permissão para ler o movimento."
          }
        }
      }
    },
    "We'll capture both, but coaching leans where you need it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen beides, aber das Coaching setzt da an, wo du es brauchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registraremos ambas, pero el coaching se centra donde más lo necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On mesure les deux, mais le coaching se concentre là où tu en as besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registriamo entrambe, ma il coaching si concentra dove ti serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を記録しますが、コーチングは必要なところに重点を置きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We leggen beide vast, maar de coaching richt zich op waar jij het nodig hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapiszemy obie, ale coaching skupi się tam, gdzie tego potrzebujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos registrar as duas, mas o coaching foca onde você mais precisa."
          }
        }
      }
    },
    "We've learned your tall posture standing and sitting, and your slouch in each. Every reading is scored against your own range for that posture." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir kennen jetzt deine aufrechte Haltung im Stehen und Sitzen und jeweils deine krumme Haltung. Jede Messung wird an deinem eigenen Bereich für diese Haltung bewertet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya conocemos tu postura erguida de pie y sentado, y tu encorvamiento en cada una. Cada lectura se puntúa según tu propio rango para esa postura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On connaît ta posture droite debout et assise, et ton avachissement dans chaque cas. Chaque mesure est évaluée selon ta propre plage pour cette posture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora conosciamo la tua postura dritta in piedi e da seduto, e la tua gobba in entrambi i casi. Ogni rilevazione viene valutata sul tuo intervallo personale per quella postura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立った姿勢と座った姿勢、それぞれの猫背を記録しました。すべての計測は、その姿勢のあなた専用の範囲で評価されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We kennen nu je rechte houding staand en zittend, en je ingezakte houding bij elk. Elke meting wordt beoordeeld op je eigen bereik voor die houding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znamy już twoją prostą postawę na stojąco i na siedząco oraz zgarbienie w każdej z nich. Każdy odczyt jest oceniany według twojego zakresu dla danej postawy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora conhecemos sua postura ereta em pé e sentado, e sua postura curvada em cada uma. Cada leitura é avaliada pelo seu próprio intervalo para aquela postura."
          }
        }
      }
    },
    "We've learned your tall posture standing and sitting, and your slouch. Every reading is scored against your own range." : {
