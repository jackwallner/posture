    "Your sitting slouch drops your head about %lld° from tall. That distance becomes your personal range." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du im Sitzen zusammensackst, senkt sich dein Kopf gegenüber der aufrechten Haltung um etwa %lld°. Dieser Abstand wird zu deiner persönlichen Spanne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sitting slouch drops your head about %lld° from tall. That distance becomes your personal range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al encorvarte sentado, tu cabeza baja unos %lld° respecto a la postura erguida. Esa distancia se convierte en tu rango personal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ti incurvi da seduto, la testa si abbassa di circa %lld° rispetto alla postura dritta. Questa distanza diventa il tuo intervallo personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座って猫背になると、背筋を伸ばした状態から頭が約%lld°下がります。この差があなた自身の範囲になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je zittend inzakt, zakt je hoofd ongeveer %lld° ten opzichte van rechtop zitten. Dat verschil wordt je persoonlijke bereik."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда ты сутулишься сидя, голова опускается примерно на %lld° от ровного положения. Это твой личный диапазон."
          }
        }
      }
    },
