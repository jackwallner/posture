    "Settle into the slump you usually catch yourself in at a desk: rounded back, chin toward your chest. When you're in your natural slouch, tap below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sink in die Haltung, in der du dich am Schreibtisch meist ertappst: runder Rücken, Kinn Richtung Brust. Wenn du in deiner typischen krummen Haltung bist, tippe unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjate caer en la postura en la que sueles pillarte en el escritorio: espalda redondeada, barbilla hacia el pecho. Cuando estés en tu encorvamiento natural, toca abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse-toi aller dans la posture où tu te surprends souvent au bureau : dos rond, menton vers la poitrine. Quand tu es dans ton avachissement habituel, touche en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciati andare nella postura in cui ti sorprendi di solito alla scrivania: schiena arrotondata, mento verso il petto. Quando sei nella tua gobba naturale, tocca qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクでよくなってしまう姿勢になってください。背中を丸め、あごを胸に近づけます。いつもの猫背になったら、下をタップしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zak in de houding waarin je jezelf aan je bureau meestal betrapt: ronde rug, kin richting borst. Zit je in je natuurlijke onderuitgezakte houding, tik dan hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opadnij w pozycję, w której zwykle łapiesz się przy biurku: okrągłe plecy, broda w stronę klatki. Gdy jesteś w swoim naturalnym zgarbieniu, stuknij poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afunde na postura em que você costuma se pegar na mesa: costas arredondadas, queixo em direção ao peito. Quando estiver na sua postura curvada natural, toque abaixo."
          }
        }
      }
    },
    "Seven minutes held tall." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
