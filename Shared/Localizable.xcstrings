    "Score at or above the day's aligned-% target and the session is a pass." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreichst du mindestens das Tagesziel in % aufrecht, ist die Einheit bestanden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si alcanzas o superas el objetivo de alineación del día, la sesión queda superada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atteins ou dépasse l’objectif d’alignement du jour, et la séance est réussie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungi o supera l’obiettivo di allineamento del giorno e la sessione è superata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その日の良い姿勢の目標%以上なら、そのセッションは合格です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal je minstens het dagdoel in % recht, dan is de sessie geslaagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnij co najmniej dzienny cel w % prosto, a sesja jest zaliczona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinja ou supere a meta de alinhamento do dia e a sessão é aprovada."
          }
        }
      }
    },
    "Score at or above the day's aligned-% target and the session is a pass. A pip fills in." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
