          "stringUnit" : {
            "state" : "translated",
            "value" : "Голова чуть подалась вперёд. Потянись макушкой вверх."
          }
        }
      }
    },
    "Drifting, lift your gaze off the pavement." : {
      "extractionState" : "manual",
