          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm kort op door je kin in te trekken. Zit daarna %#@n@ rechtop met je AirPods in. De ring toont live je houding. Je krijgt een seintje als je inzakt."
          },
          "substitutions" : {
