    "Custom lengths keep your streak. Level progress needs the level's own length." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einer frei gewählten Dauer bleibt deine Serie erhalten. Für den Level-Fortschritt zählt nur die vorgegebene Dauer."
