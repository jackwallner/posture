    "Passes add up to levels: one more minute, a slightly higher target each time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfolgreiche Einheiten bringen dich im Level voran: jedes Mal eine Minute mehr und ein etwas höheres Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passes add up to levels: one more minute, a slightly higher target each time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones superadas suman niveles: un minuto más y un objetivo un poco mayor cada vez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni superate ti fanno salire di livello: un minuto in più e un obiettivo leggermente più alto ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリアを重ねるとレベルアップ。毎回1分長くなり、目標も少し上がります。"
