    "Relaxed forgives small forward head tilt. Strict flags it sooner." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locker verzeiht leichtes Vorneigen des Kopfes. Streng meldet es früher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relajada perdona una ligera inclinación de la cabeza hacia delante. Estricta la marca antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souple tolère une légère inclinaison de la tête vers l’avant. Stricte la signale plus tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilassata tollera una leggera inclinazione in avanti della testa. Rigida la segnala prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆるめは頭の小さな前傾を許容します。きびしめは早めに知らせます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mild vergeeft een lichte voorwaartse hoofdkanteling. Streng meldt die eerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łagodna wybacza lekkie wysunięcie głowy. Surowa zgłasza je wcześniej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve tolera uma pequena inclinação da cabeça para a frente. Rigorosa avisa antes."
          }
        }
      }
    },
