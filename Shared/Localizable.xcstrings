    "Crown over hips. Shoulders soft. You're holding the shape well." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheitel über der Hüfte. Schultern locker. Du hältst die Haltung gut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coronilla sobre las caderas. Hombros sueltos. Mantienes bien la postura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommet du crâne au-dessus des hanches. Épaules détendues. Tu tiens bien la posture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testa sopra i fianchi. Spalle morbide. Stai mantenendo bene la postura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭のてっぺんが腰の真上。肩はリラックス。良い姿勢を保てています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kruin boven je heupen. Schouders ontspannen. Je houdt de vorm goed vast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czubek głowy nad biodrami. Barki luźno. Dobrze trzymasz postawę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topo da cabeça sobre o quadril. Ombros soltos. Você está mantendo bem a postura."
          }
        }
      }
    },
    "Crown up, shoulders soft, begin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scheitel hoch, Schultern locker, los."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coronilla arriba, hombros sueltos, empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crâne vers le haut, épaules détendues, c’est parti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testa alta, spalle morbide, inizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭は上へ、肩はゆるめて、始めましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kruin omhoog, schouders zacht, begin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głowa w górę, barki luźno, zaczynaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeça para cima, ombros soltos, comece."
          }
        }
      }
    },
    "Curled forward. Ears back over shoulders." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach vorn gesackt. Ohren zurück über die Schultern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encorvado hacia delante. Orejas de vuelta sobre los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penché en avant. Oreilles de nouveau au-dessus des épaules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curvo in avanti. Orecchie di nuovo sopra le spalle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前かがみです。耳を肩の上に戻しましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naar voren gezakt. Oren terug boven je schouders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochylenie do przodu. Uszy z powrotem nad barki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curvado para a frente. Orelhas de volta sobre os ombros."
          }
        }
      }
    },
    "Curled forward. Take a slow breath, lift the crown of your head." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach vorn gesackt. Atme langsam und heb den Scheitel an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
