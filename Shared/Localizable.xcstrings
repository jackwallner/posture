    "You can keep it, but a stiller hold gives more honest coaching. Re-settle and redo if you can." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sie behalten, aber eine ruhigere Haltung sorgt für ehrlicheres Coaching. Richte dich neu aus und wiederhole, wenn du kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes quedártela, pero mantenerte más quieto da un coaching más fiel. Recolócate y repítela si puedes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux la garder, mais une pose plus immobile donne un coaching plus fiable. Replace-toi et refais-la si tu peux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi tenerla, ma una posizione più ferma dà un coaching più affidabile. Risistemati e ripetila se puoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このままでも使えますが、もっと静止するとより正確にコーチできます。可能なら姿勢を整えてやり直してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt hem houden, maar stiller blijven geeft eerlijkere coaching. Ga opnieuw goed zitten en doe het nog eens als het lukt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz go zachować, ale spokojniejsza pozycja daje uczciwszy coaching. Ustaw się ponownie i powtórz, jeśli możesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode manter, mas ficar mais parado dá um coaching mais fiel. Ajeite-se e refaça se puder."
          }
        }
      }
    },
    "You can redo this anytime from Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
