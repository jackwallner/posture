    "Stack your ears over your shoulders." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohren über die Schultern stapeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apila las orejas sobre los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aligne tes oreilles au-dessus des épaules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allinea le orecchie sopra le spalle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "耳を肩の真上に重ねましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breng je oren boven je schouders."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw uszy nad barkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alinhe as orelhas sobre os ombros."
          }
        }
      }
    },
    "Stand up and reach for the ceiling. A 10-second stretch resets your alignment." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh auf und streck dich zur Decke. 10 Sekunden Dehnen richten dich neu aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie y estírate hacia el techo. Un estiramiento de 10 segundos reajusta tu alineación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lève-toi et tends les bras vers le plafond. 10 secondes d’étirement réalignent ta posture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzati e allungati verso il soffitto. Un allungamento di 10 secondi risistema il tuo allineamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がって天井へ手を伸ばしましょう。10秒のストレッチで姿勢が整います。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta op en reik naar het plafond. Tien seconden strekken zet je houding weer recht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstań i sięgnij do sufitu. 10-sekundowe rozciąganie resetuje ustawienie ciała."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levante-se e estique os braços até o teto. Um alongamento de 10 segundos reajusta seu alinhamento."
          }
        }
      }
    },
    "Stand up tall." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh aufrecht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie, erguido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiens-toi debout, bien droit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzati dritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背筋を伸ばして立ってください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta rechtop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stań prosto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé, ereto."
          }
        }
      }
    },
    "Stand with your feet hip-width apart. Stack your ears over your shoulders, shoulders over hips, and lengthen up through the crown of your head, chin level. When you're standing tall and steady, tap below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dich hüftbreit hin. Ohren über die Schultern, Schultern über die Hüfte, und wachse über den Scheitel nach oben, Kinn waagerecht. Wenn du aufrecht und ruhig stehst, tippe unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie con los pies a la anchura de las caderas. Orejas sobre los hombros, hombros sobre las caderas, y crece desde la coronilla, barbilla nivelada. Cuando estés erguido y estable, toca abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieds écartés de la largeur des hanches. Oreilles au-dessus des épaules, épaules au-dessus des hanches, et grandis-toi par le sommet du crâne, menton à l’horizontale. Quand tu es droit et stable, touche en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettiti in piedi con i piedi alla larghezza dei fianchi. Orecchie sopra le spalle, spalle sopra i fianchi, e allungati dalla sommità della testa, mento parallelo al pavimento. Quando sei dritto e stabile, tocca qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足を腰幅に開いて立ちます。耳を肩の上に、肩を腰の上に重ね、頭のてっぺんから上へ伸びて、あごは水平に。背筋が伸びて安定したら、下をタップしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta met je voeten op heupbreedte. Oren boven je schouders, schouders boven je heupen, en strek je uit via je kruin, kin recht. Sta je rechtop en stil, tik dan hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stań ze stopami na szerokość bioder. Uszy nad barkami, barki nad biodrami, wydłuż się przez czubek głowy, broda poziomo. Gdy stoisz prosto i stabilnie, stuknij poniżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique em pé com os pés na largura do quadril. Orelhas sobre os ombros, ombros sobre o quadril, e alongue-se pelo topo da cabeça, queixo nivelado. Quando estiver ereto e firme, toque abaixo."
          }
        }
      }
    },
    "Standing" : {
