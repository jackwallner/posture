    "That read was a little shaky." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung war etwas wackelig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa lectura salió algo inestable."
          }
        },
        "fr" : {
          "stringUnit" : {
