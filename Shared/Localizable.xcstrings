    "Set a timer to check your posture, since awareness is the first step to improvement." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell dir einen Timer für einen Haltungscheck, denn Bewusstsein ist der erste Schritt zur Verbesserung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un temporizador para revisar tu postura: ser consciente es el primer paso para mejorar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programme un minuteur pour vérifier ta posture : la prise de conscience est le premier pas vers le progrès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta un timer per controllare la postura: la consapevolezza è il primo passo per migliorare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーで姿勢をチェック。気づくことが改善への第一歩です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een timer om je houding te checken, want bewustzijn is de eerste stap naar verbetering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw minutnik na kontrolę postawy, bo świadomość to pierwszy krok do poprawy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programe um timer para checar sua postura, porque ter consciência é o primeiro passo para melhorar."
          }
        }
      }
    },
