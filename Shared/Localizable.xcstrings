          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine gespeicherte Haltung beim Gehen vollständig. Beim nächsten Spaziergang beginnt die 30-sekündige Einrichtung erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgets your saved walking posture entirely. Your next walk runs the 30-second walking setup again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra la postura al caminar que guardaste. En tu próxima caminata volverás a configurarla en 30 segundos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella la postura di camminata salvata. Alla prossima camminata ripeterai la configurazione di 30 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した歩行姿勢を完全に消去します。次のウォーキングでは、30秒間の歩行設定をもう一度行います。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opgeslagen wandelhouding wordt volledig gewist. Bij je volgende wandeling stel je die in 30 seconden opnieuw in."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью удаляет сохранённое положение тела при ходьбе. В начале следующей прогулки настройка займёт 30 секунд."
          }
        }
      }
    },
    "Forward head, rounded shoulders on your feet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Stehen: Kopf nach vorn, Schultern gerundet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forward head, rounded shoulders on your feet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeza adelantada y hombros curvados al estar de pie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testa in avanti e spalle curve mentre sei in piedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立っているときに頭が前に出て、肩が丸まる。"
          }
        },
        "nl" : {
