    "Hold it tall for %@ more. Finish and today's streak day is yours; hit the target %% and you level up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleib noch %@ aufrecht. Schließe ab und sichere deinen Serientag. Erreiche den Zielwert in %%, um ein Level aufzusteigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold it tall for %@ more. Finish and today's streak day is yours; hit the target %% and you level up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantente erguido %@ más. Termina para mantener tu racha; alcanza el %% objetivo y subirás de nivel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la postura eretta ancora per %@. Completa l’esercizio e il giorno conta per la serie; raggiungi l’obiettivo in %% e sali di livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと%@、背筋を伸ばしてキープ。最後まで続けると連続記録が続き、目標の%%に達するとレベルアップします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf nog %@ rechtop. Maak de oefening af en vandaag telt mee voor je reeks; haal het doel van %% en je gaat een level omhoog."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Держи осанку ещё %@. Заверши занятие, чтобы сохранить серию, и достигни цели в %%, чтобы перейти на следующий уровень."
          }
        }
      }
    },
