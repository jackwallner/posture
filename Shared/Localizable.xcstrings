    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, sofern du nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums kündigst. Verwalten oder kündigen unter Einstellungen › Apple Account › Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles al menos 24 horas antes de que termine el periodo actual. Gestiona o cancela en Ajustes › Apple ID › Suscripciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non disdici almeno 24 ore prima della fine del periodo in corso. Gestisci o disdici in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間の終了24時間前までにキャンセルしない限り、自動更新されます。管理やキャンセルは「設定」›「Apple ID」›「サブスクリプション」で行えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch verlengd, tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op via Instellingen › Apple ID › Abonnementen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца текущего периода. Управление и отмена: Настройки › Apple ID › Подписки."
          }
        }
      }
    },
    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, sofern du nicht mindestens 24 Stunden vor Ablauf des aktuellen Zeitraums kündigst. Verwalten oder kündigen in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que canceles al menos 24 horas antes de que termine el periodo actual. Gestiona o cancela en Ajustes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non disdici almeno 24 ore prima della fine del periodo in corso. Gestisci o disdici in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間の終了24時間前までにキャンセルしない限り、自動更新されます。管理やキャンセルは「設定」で行えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch verlengd, tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op in Instellingen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продлевается автоматически, если не отменить подписку минимум за 24 часа до конца текущего периода. Управление и отмена в Настройках."
          }
        }
      }
    },
