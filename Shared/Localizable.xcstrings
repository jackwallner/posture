    "Relaxed forgives small forward head tilt. Strict flags it sooner." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locker toleriert eine leichte Neigung des Kopfes nach vorn. Streng meldet sie früher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxed forgives small forward head tilt. Strict flags it sooner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo flexible permite una ligera inclinación de la cabeza hacia delante. El estricto la detecta antes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tollerante ammette una leggera inclinazione della testa in avanti. Rigorosa la segnala prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ゆるやか」では頭が少し前に傾いても許容します。「厳しめ」では早めにお知らせします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij Soepel mag je hoofd iets naar voren kantelen. Bij Streng krijg je eerder een seintje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкий режим допускает небольшой наклон головы вперёд. Строгий замечает его раньше."
          }
        }
      }
    },
