    },
    "You've stopped moving. The clock keeps running, but standing still counts as rest - keep walking." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bewegst dich nicht mehr. Die Uhr läuft weiter, aber Stehen zählt als Pause, also geh weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te has detenido. El reloj sigue corriendo, pero estar quieto cuenta como descanso, así que sigue caminando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne bouges plus. Le chrono continue, mais rester immobile compte comme du repos, alors continue de marcher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti sei fermato. Il timer continua, ma stare fermi conta come riposo, quindi continua a camminare."
