    "AirPods sit a little differently over time, and posture shifts too. A quick reset keeps readings honest." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods sitzen mit der Zeit etwas anders, und auch die Haltung verändert sich. Ein kurzer Reset hält die Messungen ehrlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los AirPods se colocan un poco distinto con el tiempo, y la postura también cambia. Un reinicio rápido mantiene las lecturas fieles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les AirPods se placent un peu différemment avec le temps, et la posture change aussi. Une remise à zéro rapide garde des mesures fiables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli AirPods si posizionano in modo un po’ diverso col tempo, e anche la postura cambia. Un reset veloce mantiene le rilevazioni affidabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsの装着具合は少しずつ変わり、姿勢も変化します。手早くリセットすれば計測の正確さを保てます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods zitten na verloop van tijd net iets anders, en je houding verandert ook. Een snelle reset houdt de metingen eerlijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods z czasem leżą trochę inaczej, a postawa też się zmienia. Szybki reset utrzymuje rzetelne odczyty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os AirPods se encaixam um pouco diferente com o tempo, e a postura também muda. Um ajuste rápido mantém as leituras fiéis."
          }
        }
      }
    },
