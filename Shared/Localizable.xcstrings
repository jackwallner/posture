    "Your sitting slouch drops your head about %lld° from tall. That distance becomes your personal range." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krumm im Sitzen senkt sich dein Kopf um etwa %lld° gegenüber aufrecht. Dieser Abstand wird dein persönlicher Bereich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al encorvarte sentado, tu cabeza baja unos %lld° respecto a erguido. Esa distancia será tu rango personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avachi en position assise, ta tête descend d’environ %lld° par rapport à droit. Cet écart devient ta plage personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingobbito da seduto, la testa scende di circa %lld° rispetto a quando sei dritto. Quella distanza diventa il tuo intervallo personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座って猫背になると、頭が良い姿勢より約%lld°下がります。この差があなた専用の範囲になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingezakt zittend zakt je hoofd ongeveer %lld° ten opzichte van rechtop. Dat verschil wordt je persoonlijke bereik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garbiąc się na siedząco, opuszczasz głowę o około %lld° względem prostej postawy. Ta różnica staje się twoim osobistym zakresem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curvado sentado, sua cabeça desce cerca de %lld° em relação à postura ereta. Essa distância vira seu intervalo pessoal."
          }
        }
      }
    },
