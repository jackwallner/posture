    "Optional AirPods and Watch nudges beyond practice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionale Hinweise über AirPods und Apple Watch außerhalb der Übung"
          }
        },
