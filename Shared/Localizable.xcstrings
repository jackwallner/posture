    "Retune just the posture that's drifted, standing, sitting, or your walking stride. Recalibrating one keeps the others as they are." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibriere nur die Haltung neu, die sich verändert hat: im Stehen, im Sitzen oder beim Gehen. Die anderen bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retune just the posture that's drifted, standing, sitting, or your walking stride. Recalibrating one keeps the others as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta solo la postura que haya cambiado: de pie, sentado o al caminar. Al volver a calibrar una, las demás no cambian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricalibra solo la postura che è cambiata: in piedi, da seduto o mentre cammini. Le altre resteranno invariate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立位、座位、歩行時のうち、ずれが生じた姿勢だけを調整できます。1つを再キャリブレーションしても、ほかの設定はそのままです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalibreer alleen de houding die is veranderd: je sta-, zit- of wandelhouding. De andere blijven ongewijzigd."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настрой заново только то положение, которое изменилось: стоя, сидя или при ходьбе. Калибровка одного не изменит остальные."
          }
        }
      }
    },
    "Right now" : {
