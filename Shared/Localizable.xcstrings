          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos podido leer esa postura. Inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a rilevare la posizione. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その姿勢を読み取れませんでした。もう一度お試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden die houding niet meten. Probeer het opnieuw."
          }
        },
