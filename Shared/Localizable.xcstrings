    "Forgets your saved walking posture entirely. Your next walk runs the 30-second walking setup again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine gespeicherte Gehhaltung komplett. Dein nächster Spaziergang startet wieder mit der 30-Sekunden-Einrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra por completo tu postura al caminar guardada. Tu próxima caminata volverá a hacer la configuración de 30 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
