    "Hold it tall for %@ more. Finish and today's streak day is yours; hit the target %% and you level up." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte dich noch %@ aufrecht. Bring es zu Ende, und der heutige Serientag gehört dir. Erreichst du das Ziel in %%, steigst du auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantente erguido %@ más. Termina y el día de racha es tuyo; alcanza el objetivo de %% y subes de nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiens-toi droit encore %@. Termine et ton jour de série est acquis ; atteins l’objectif en %% et tu montes de niveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta dritto ancora %@. Completa e il giorno della serie è tuo; raggiungi l’obiettivo in %% e sali di livello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと%@、背筋を伸ばしてキープ。やり切れば今日の連続記録はあなたのもの。目標%%に届けばレベルアップです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf nog %@ rechtop. Maak het af en de reeksdag van vandaag is van jou; haal het doel in %% en je gaat een niveau omhoog."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj się prosto jeszcze %@. Dokończ, a dzisiejszy dzień serii jest twój; osiągnij cel w %%, a awansujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fique ereto por mais %@. Termine e o dia de sequência é seu; bata a meta em %% e você sobe de nível."
          }
        }
      }
    },
    "Hold it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten."
          }
        },
