    "Where most of the slouching happens. Same long spine, different base." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier sackt man am häufigsten zusammen. Auch hier gilt: Rücken lang, nur die Basis ist anders."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where most of the slouching happens. Same long spine, different base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donde más solemos encorvarnos. La columna se alarga igual, cambia la base."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È qui che ci si incurva più spesso. La schiena resta distesa, cambia la base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "猫背になりやすい姿勢です。背筋を伸ばすのは同じですが、体を支える位置が違います。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier zak je het vaakst in. Dezelfde lange rug, een andere basis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь чаще всего сутулятся. Спина так же вытянута, но опора другая."
          }
        }
      }
    },
    "Where the time went" : {
