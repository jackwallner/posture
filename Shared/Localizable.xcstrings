    "Both feet on the floor, knees roughly level with your hips." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Füße am Boden, Knie etwa auf Hüfthöhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos pies en el suelo, rodillas más o menos a la altura de las caderas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux pieds au sol, genoux à peu près à hauteur des hanches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i piedi a terra, ginocchia più o meno all’altezza dei fianchi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両足を床につけ、ひざは腰とほぼ同じ高さに。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide voeten op de grond, knieën ongeveer op heuphoogte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obie stopy na podłodze, kolana mniej więcej na wysokości bioder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dois pés no chão, joelhos mais ou menos na altura do quadril."
          }
        }
      }
    },
    "Breathe and settle" : {
