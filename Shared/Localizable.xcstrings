            "value" : "歩き続ける"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf lopen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idź dalej"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar andando"
          }
        }
      }
    },
    "Keep walking, the count holds while you're stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh weiter, der Zähler hält an, solange du stehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue caminando; la cuenta se detiene mientras estás parado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue de marcher, le compteur s’arrête quand tu es immobile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua a camminare, il conteggio si ferma mentre sei fermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歩き続けてください。止まっている間はカウントが止まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf lopen, de telling pauzeert als je stilstaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idź dalej, licznik stoi, gdy się zatrzymujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue andando; a contagem pausa enquanto você está parado."
          }
        }
      }
    },
    "Keep your feet flat on the floor and knees at 90 degrees." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Füße flach auf den Boden, Knie im 90-Grad-Winkel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los pies planos en el suelo y las rodillas a 90 grados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde les pieds à plat au sol et les genoux à 90 degrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni i piedi a terra e le ginocchia a 90 gradi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足裏を床につけ、ひざは90度に。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je voeten plat op de grond en je knieën in een hoek van 90 graden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj stopy płasko na podłodze, a kolana pod kątem 90 stopni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha os pés apoiados no chão e os joelhos a 90 graus."
          }
        }
      }
    },
