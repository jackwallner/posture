    "Tall and easy. Keep breathing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufrecht und entspannt. Atme weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tall and easy. Keep breathing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erguido y relajado. Sigue respirando."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In posizione eretta e rilassata. Continua a respirare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姿勢を整え、力を抜いて。呼吸を続けましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtop en ontspannen. Blijf ademen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выпрямись и расслабься. Дыши спокойно."
          }
        }
      }
    },
    "Tall posture is a stack, not a strain. Line these up and let everything else relax." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufrechte Haltung entsteht durch Ausrichtung, nicht durch Anspannung. Richte diese Punkte aus und entspanne den Rest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tall posture is a stack, not a strain. Line these up and let everything else relax."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una postura erguida consiste en alinearse, sin hacer fuerza. Alinea estos puntos y relaja todo lo demás."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una postura eretta nasce dall'allineamento, senza sforzo. Allinea questi punti e rilassa tutto il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姿勢を整えるには、力まず頭や肩、腰の位置をそろえることが大切です。位置がそろったら、あとは力を抜きましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtop staan of zitten hoeft niet geforceerd. Breng deze punten boven elkaar en ontspan de rest."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы держаться прямо, выстрой тело по этим ориентирам без лишнего напряжения. Остальные мышцы расслабь."
          }
        }
      }
    },
