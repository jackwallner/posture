      }
    },
    "Free during trial, then %@. Auto-renews unless cancelled 24h before trial ends." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Probeabo kostenlos, danach %@. Verlängert sich automatisch, sofern du nicht spätestens 24 Std. vor Ende des Probeabos kündigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
