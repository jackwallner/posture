    "Hips over ankles, shoulders over hips, ears over shoulders." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hüfte über den Knöcheln, Schultern über der Hüfte, Ohren über den Schultern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caderas sobre los tobillos, hombros sobre las caderas, orejas sobre los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanches au-dessus des chevilles, épaules au-dessus des hanches, oreilles au-dessus des épaules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fianchi sopra le caviglie, spalle sopra i fianchi, orecchie sopra le spalle."
