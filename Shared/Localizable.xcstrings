    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings › Apple ID › Subscriptions." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch, wenn nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt wird. Verwalten oder kündigen unter Einstellungen › Apple-ID › Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente salvo que lo canceles al menos 24 horas antes del final del periodo actual. Gestiónalo o cancélalo en Ajustes › ID de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique sauf résiliation au moins 24 heures avant la fin de la période en cours. Gère ou résilie dans Réglages › Identifiant Apple › Abonnements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente se non disdici almeno 24 ore prima della fine del periodo in corso. Gestisci o disdici in Impostazioni › ID Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間終了の24時間前までに解約しない限り自動更新されます。「設定」›「Apple ID」›「サブスクリプション」で管理・解約できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op via Instellingen › Apple ID › Abonnementen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnawia się automatycznie, jeśli nie anulujesz co najmniej 24 godziny przed końcem bieżącego okresu. Zarządzaj lub anuluj w Ustawienia › Apple ID › Subskrypcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele em Ajustes › Apple ID › Assinaturas."
          }
        }
      }
    },
