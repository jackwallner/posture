    "One finished practice (or walk, or check-in) a day keeps it alive." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine abgeschlossene Übung (oder ein Spaziergang oder Check-in) pro Tag hält sie am Leben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
