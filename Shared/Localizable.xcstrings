      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Erinnerung am Tag für deine Haltungsübung, ein paar Minuten aufrecht mit Live-Coaching über AirPods. Wenn du sie abschließt, bleibt deine Serie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio al día para tu práctica de postura, unos minutos erguido con coaching en directo de los AirPods. Completarla mantiene tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel par jour pour ta séance de posture, quelques minutes droit avec le coaching en direct des AirPods. La terminer garde ta série."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria al giorno per la pratica di postura, pochi minuti dritto con il coaching in tempo reale degli AirPods. Completarla mantiene la serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日1回、姿勢練習のリマインダー。AirPodsのライブコーチングで数分背筋を伸ばします。完了すると連続記録が続きます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén herinnering per dag voor je houdingsoefening, een paar minuten rechtop met live coaching via AirPods. Maak hem af en je reeks blijft staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno przypomnienie dziennie o ćwiczeniu postawy, kilka minut prosto z coachingiem AirPods na żywo. Ukończenie podtrzymuje serię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lembrete por dia para sua prática de postura, poucos minutos ereto com coaching ao vivo pelos AirPods. Concluir mantém sua sequência."
          }
        }
      }
    },
    "One short session a day, starting at three minutes. Streaks and levels keep it growing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
