    "Gently draw your chin straight back, like a small double chin, then return to level. Slow and easy." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh dein Kinn sanft gerade nach hinten, wie ein kleines Doppelkinn, dann zurück zur Mitte. Langsam und locker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva la barbilla suavemente hacia atrás, como una pequeña papada, y vuelve al centro. Lento y suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramène doucement le menton vers l’arrière, comme un petit double menton, puis reviens au neutre. Lentement, en douceur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta delicatamente il mento indietro, come un piccolo doppio mento, poi torna in posizione. Lento e morbido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あごをゆっくりまっすぐ後ろに引きます。小さな二重あごをつくるように。そして元に戻します。ゆっくり、やさしく。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trek je kin zachtjes recht naar achteren, als een kleine onderkin, en keer terug naar het midden. Rustig en ontspannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatnie cofnij brodę prosto do tyłu, jak przy małym podwójnym podbródku, potem wróć do środka. Powoli i spokojnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leve o queixo suavemente para trás, como um pequeno queixo duplo, e volte ao centro. Devagar e com calma."
          }
        }
      }
    },
