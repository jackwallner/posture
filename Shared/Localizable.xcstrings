          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perché la progressione conta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "段階的に伸ばす理由"
          }
        },
        "nl" : {
          "stringUnit" : {
