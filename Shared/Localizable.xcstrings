    "Every walk is now scored against your own tall stride. Redo this anytime from Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Spaziergang wird jetzt anhand deines eigenen aufrechten Gangs bewertet. Du kannst das jederzeit in den Einstellungen wiederholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every walk is now scored against your own tall stride. Redo this anytime from Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora cada caminata se evalúa según tu propia postura erguida al caminar. Puedes repetirlo cuando quieras desde Ajustes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni camminata viene ora valutata in base alla tua postura di riferimento. Puoi ripetere la configurazione quando vuoi da Impostazioni."
