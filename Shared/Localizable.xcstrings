            "value" : "Stimm nur die Haltung neu ab, die abgedriftet ist: Stehen, Sitzen oder dein Gang. Die anderen bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta solo la postura que se ha desviado: de pie, sentado o tu forma de caminar. Recalibrar una mantiene las demás como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réajuste seulement la posture qui a dérivé : debout, assis ou ta foulée. Recalibrer l’une laisse les autres telles quelles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricalibra solo la postura che è cambiata: in piedi, da seduto o il tuo passo. Ricalibrarne una lascia le altre come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ずれてきた姿勢だけを調整し直せます。立つ、座る、歩くのいずれか。1つを調整しても、ほかはそのまま残ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel alleen de houding opnieuw af die is afgeweken: staan, zitten of je looppas. De andere blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostrój tylko tę postawę, która się rozjechała: stanie, siedzenie albo krok. Kalibracja jednej zostawia pozostałe bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reajuste só a postura que mudou: em pé, sentado ou sua passada. Recalibrar uma mantém as outras como estão."
          }
        }
      }
    },
