        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quick chin-tuck warm-up, then %#@n@ sitting tall with your AirPods in. The ring shows your alignment live, and a nudge catches you if you drift."
          },
          "substitutions" : {
            "n" : {
