          "stringUnit" : {
            "state" : "translated",
            "value" : "Te inclinas hacia delante. Lleva las orejas sobre los hombros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei incurvato in avanti. Riporta le orecchie sopra le spalle."
