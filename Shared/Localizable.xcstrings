          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengthen up through the crown, ears over shoulders, chin level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estírate desde la coronilla, con las orejas sobre los hombros y el mentón nivelado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allunga la sommità della testa verso l'alto, orecchie sopra le spalle e mento parallelo al pavimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭頂部を上に伸ばし、耳を肩の真上に、あごを水平にしましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak je lang vanuit je kruin, oren boven je schouders, kin recht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потянись макушкой вверх, уши над плечами, подбородок ровно."
          }
        }
      }
    },
    "Let your head float back over your spine, not out in front of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass deinen Kopf sanft zurück über die Wirbelsäule gleiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let your head float back over your spine, not out in front of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva la cabeza suavemente hacia atrás, sobre la columna."
