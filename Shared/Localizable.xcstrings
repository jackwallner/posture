    "Set your screen at eye level to prevent forward head tilt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell deinen Bildschirm auf Augenhöhe, damit der Kopf nicht nach vorn kippt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca la pantalla a la altura de los ojos para no adelantar la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place ton écran à hauteur des yeux pour éviter de pencher la tête en avant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti lo schermo all’altezza degli occhi per evitare di inclinare la testa in avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭が前に傾かないよう、画面を目の高さに合わせましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je scherm op ooghoogte zodat je hoofd niet naar voren kantelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw ekran na wysokości oczu, aby głowa nie wysuwała się do przodu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a tela na altura dos olhos para evitar inclinar a cabeça para a frente."
          }
        }
      }
    },
