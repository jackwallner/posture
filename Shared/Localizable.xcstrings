    "Green means aligned, amber means drifting, coral means slouching. Your AirPods read it about 25 times a second." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grün heißt aufrecht, Gelb heißt absinkend, Koralle heißt krumm. Deine AirPods messen das etwa 25-mal pro Sekunde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde es alineada, ámbar es cediendo, coral es encorvada. Tus AirPods la leen unas 25 veces por segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vert veut dire alignée, ambre relâchée, corail avachie. Tes AirPods la mesurent environ 25 fois par seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde significa allineata, ambra in calo, corallo ingobbita. I tuoi AirPods la leggono circa 25 volte al secondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑は良い姿勢、黄色は崩れ気味、コーラルは猫背。AirPodsが1秒に約25回読み取ります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groen is recht, amber is inzakkend, koraal is onderuit. Je AirPods meten dat zo'n 25 keer per seconde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zielony to prosto, bursztynowy to opadanie, koralowy to garbienie się. Twoje AirPods mierzą to około 25 razy na sekundę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde é alinhada, âmbar é cedendo, coral é curvada. Seus AirPods leem isso umas 25 vezes por segundo."
          }
        }
      }
    },
