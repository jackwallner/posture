    "Small adjustments throughout the day add up to lasting change." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Anpassungen über den Tag summieren sich zu dauerhafter Veränderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los pequeños ajustes a lo largo del día suman un cambio duradero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De petits ajustements au fil de la journée finissent par créer un changement durable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piccoli aggiustamenti durante la giornata si sommano in un cambiamento duraturo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日を通した小さな調整が、長続きする変化につながります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine aanpassingen door de dag heen tellen op tot blijvende verandering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drobne korekty w ciągu dnia składają się na trwałą zmianę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequenos ajustes ao longo do dia somam uma mudança duradoura."
          }
        }
      }
    },
    "Stack up" : {
