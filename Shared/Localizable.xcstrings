    "AirPods sit a little differently over time, and posture shifts too. A quick reset keeps readings honest." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods sitzen mit der Zeit etwas anders, und auch deine Haltung verändert sich. Ein kurzes Zurücksetzen sorgt für verlässliche Messungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods sit a little differently over time, and posture shifts too. A quick reset keeps readings honest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el tiempo, los AirPods pueden colocarse de forma distinta y tu postura también cambia. Un reajuste rápido ayuda a mantener la precisión de las lecturas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Col tempo gli AirPods possono posizionarsi in modo diverso, e anche la postura cambia. Una rapida ricalibrazione mantiene affidabili le rilevazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsの装着位置や姿勢は少しずつ変わります。ときどき設定し直すと、正確な測定につながります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je AirPods kunnen na verloop van tijd anders zitten en je houding verandert ook. Stel opnieuw in voor betrouwbare metingen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со временем посадка AirPods и осанка меняются. Быстрая перенастройка поможет сохранить точность измерений."
          }
        }
      }
    },
