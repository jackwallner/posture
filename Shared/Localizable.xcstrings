    "Stand up and reach for the ceiling. A 10-second stretch resets your alignment." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh auf und streck dich zur Decke. Richte dich mit einer Dehnung von 10 Sekunden neu aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand up and reach for the ceiling. A 10-second stretch resets your alignment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte de pie y estírate hacia el techo. Un estiramiento de 10 segundos reajusta tu alineación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzati e allungati verso il soffitto. Dieci secondi di stretching aiutano a ritrovare l'allineamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がって天井に向かって伸びましょう。10秒のストレッチで姿勢を整え直します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta op en reik naar het plafond. Rek je 10 seconden uit om weer rechtop te staan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встань и потянись к потолку. Десятисекундная растяжка поможет выпрямиться."
          }
        }
      }
    },
    "Stand up tall." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steh aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
