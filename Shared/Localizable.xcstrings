    "Both feet on the floor, knees roughly level with your hips." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Füße auf den Boden, die Knie etwa auf Höhe der Hüften."
