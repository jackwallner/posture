    "A daily posture practice, coached by your AirPods. A few minutes held tall each day, with live feedback, that's how posture actually changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine tägliche Haltungsübung mit den AirPods als Coach. Ein paar Minuten aufrecht am Tag, mit Live-Feedback: So verändert sich deine Haltung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A daily posture practice, coached by your AirPods. A few minutes held tall each day, with live feedback, that's how posture actually changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una práctica diaria de postura guiada por tus AirPods. Unos minutos al día con buena postura y comentarios al instante: así cambia tu postura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un esercizio quotidiano di postura, guidato dagli AirPods. Pochi minuti al giorno con la schiena dritta e feedback in tempo reale: così la postura cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPodsのコーチングで、毎日姿勢の練習をしましょう。リアルタイムのフィードバックを受けながら、1日数分、背筋を伸ばしましょう。その積み重ねで、姿勢は変わっていきます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dag je houding oefenen met je AirPods als coach. Een paar minuten per dag rechtop, met directe feedback. Zo verandert je houding echt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ежедневная практика осанки с AirPods. Несколько минут с ровной осанкой каждый день и обратная связь в реальном времени помогают менять привычки."
          }
        }
      }
    },
    "A few minutes a day." : {
