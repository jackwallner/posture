          }
        }
      }
    },
    "One honest check-in protects today's streak and helps the pattern show up over time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ehrlicher Check-in schützt deine heutige Serie und lässt das Muster mit der Zeit sichtbar werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un check-in sincero protege la racha de hoy y ayuda a que el patrón aparezca con el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un check-in honnête protège ta série du jour et aide à faire apparaître ta tendance au fil du temps."
