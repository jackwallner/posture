    "Lengthen up" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach oben strecken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estírate hacia arriba"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandis-toi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allungati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上へ伸ばす"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strek je uit"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydłuż się"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alongue-se para cima"
          }
        }
      }
    },
    "Lengthen up through the crown, ears over shoulders, chin level." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über den Scheitel nach oben strecken, Ohren über den Schultern, Kinn waagerecht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estírate desde la coronilla, orejas sobre los hombros, barbilla nivelada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grandis-toi par le sommet du crâne, oreilles au-dessus des épaules, menton à l’horizontale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allungati dalla sommità della testa, orecchie sopra le spalle, mento parallelo al pavimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭のてっぺんから上へ伸ばし、耳は肩の上、あごは水平に。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strek je uit via je kruin, oren boven je schouders, kin recht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydłuż się przez czubek głowy, uszy nad barkami, broda poziomo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alongue-se pelo topo da cabeça, orelhas sobre os ombros, queixo nivelado."
          }
        }
      }
    },
    "Let your head float back over your spine, not out in front of it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass deinen Kopf zurück über die Wirbelsäule gleiten, nicht davor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que la cabeza vuelva sobre la columna, no por delante de ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse ta tête revenir au-dessus de ta colonne, pas devant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che la testa torni sopra la colonna, non davanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭を背骨の上に戻します。前に出さないように。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je hoofd terugzweven boven je wervelkolom, niet ervoor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól głowie wrócić nad kręgosłup, a nie przed niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a cabeça voltar para cima da coluna, não à frente dela."
          }
        }
      }
    },
    "Let your shoulders drop away from your ears." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass die Schultern von den Ohren weg sinken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que los hombros bajen, lejos de las orejas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse tes épaules descendre, loin des oreilles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia scendere le spalle, lontano dalle orecchie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肩を耳から遠ざけるように下ろしましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je schouders zakken, weg van je oren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opuść barki, z dala od uszu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe os ombros descerem, longe das orelhas."
          }
        }
      }
    },
