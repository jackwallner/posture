    "Off uses a step-based estimate. GPS is more accurate outdoors and uses more battery." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist GPS aus, wird anhand deiner Schritte geschätzt. Draußen ist GPS genauer, verbraucht aber mehr Batterie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off uses a step-based estimate. GPS is more accurate outdoors and uses more battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo desactivas, se usa una estimación basada en los pasos. El GPS es más preciso al aire libre y consume más batería."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, usa una stima basata sui passi. Il GPS è più preciso all'aperto e consuma più batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合は歩数から推定します。GPSは屋外でより正確ですが、バッテリーを多く消費します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit uitstaat, wordt een schatting op basis van stappen gebruikt. GPS is buiten nauwkeuriger en verbruikt meer batterij."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без GPS расстояние рассчитывается по шагам. На улице GPS точнее, но расходует больше заряда."
          }
        }
      }
    },
