    "Settle into the slump you usually catch yourself in at a desk: rounded back, chin toward your chest. When you're in your natural slouch, tap below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sack so zusammen, wie du es oft am Schreibtisch tust: mit rundem Rücken und dem Kinn Richtung Brust. Wenn du natürlich zusammengesackt bist, tippe unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settle into the slump you usually catch yourself in at a desk: rounded back, chin toward your chest. When you're in your natural slouch, tap below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adopta la postura encorvada que sueles tener en el escritorio: espalda redondeada y mentón hacia el pecho. Cuando estés encorvado de forma natural, toca abajo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assumi la posizione incurvata che prendi di solito alla scrivania: schiena arrotondata e mento verso il petto. Quando sei nella tua postura incurvata naturale, tocca qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクにいるときのいつもの姿勢になりましょう。背中を丸め、あごを胸に近づけます。自然な猫背になったら、下をタップしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zak in zoals je dat vaak achter je bureau doet: met een ronde rug en je kin richting je borst. Tik hieronder als je in je gebruikelijke ingezakte houding zit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прими привычную позу за столом: округли спину и опусти подбородок к груди. Когда привычно сутулишься, нажми ниже."
          }
        }
      }
    },
    "Seven minutes held tall." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieben Minuten aufrecht geblieben."
          }
        },
