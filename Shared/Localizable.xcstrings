            "state" : "translated",
            "value" : "Avvisi facoltativi con AirPods e Apple Watch oltre l’esercizio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "練習以外にもAirPodsとApple Watchでお知らせ（任意）"
          }
        },
        "nl" : {
