            "state" : "translated",
            "value" : "Mettiti in piedi in posizione eretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "姿勢を整えて立ちましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta rechtop."
