    "Tall posture is a stack, not a strain. Line these up and let everything else relax." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufrechte Haltung ist ein Stapel, keine Anstrengung. Bring das in eine Linie und lass alles andere locker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La postura erguida es una pila, no una tensión. Alinea esto y deja que todo lo demás se relaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une posture droite, c’est un empilement, pas une tension. Aligne ces points et laisse tout le reste se détendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La postura dritta è un allineamento, non uno sforzo. Metti in fila questi punti e lascia rilassare tutto il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "良い姿勢は力むことではなく、積み重ねることです。これらを一直線にそろえて、ほかは力を抜きましょう。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een rechte houding is een stapeling, geen inspanning. Breng deze op één lijn en laat de rest ontspannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosta postawa to ułożenie, a nie napięcie. Ustaw te punkty w linii i pozwól reszcie się rozluźnić."
