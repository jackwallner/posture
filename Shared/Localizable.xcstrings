    "A clean, steady read of your sitting posture. This is the baseline you'll be coached back to." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine saubere, ruhige Messung deiner Sitzhaltung. Das ist die Referenz, zu der wir dich zurückcoachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una lectura limpia y estable de tu postura sentado. Esta es la referencia a la que te guiaremos de vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mesure nette et stable de ta posture assise. C’est la référence vers laquelle on te ramènera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una rilevazione pulita e stabile della tua postura da seduto. È il riferimento a cui ti riporteremo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座った姿勢をきれいに安定して計測できました。これがコーチングで戻す基準になります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een zuivere, stabiele meting van je zithouding. Dit is de referentie waar we je naar terug coachen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czysty, stabilny odczyt postawy na siedząco. To punkt odniesienia, do którego będziemy cię prowadzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma leitura limpa e estável da sua postura sentada. Esta é a referência para a qual vamos guiar você de volta."
          }
        }
      }
    },
    "A clean, steady read of your standing posture. This is the baseline you'll be coached back to." : {
