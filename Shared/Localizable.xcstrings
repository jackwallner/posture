    "Off uses a step-based estimate. GPS is more accurate outdoors and uses more battery." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus nutzt eine Schätzung aus den Schritten. GPS ist draußen genauer und verbraucht mehr Akku."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado usa una estimación por pasos. El GPS es más preciso al aire libre y gasta más batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, une estimation basée sur les pas est utilisée. Le GPS est plus précis dehors et consomme plus de batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato usa una stima basata sui passi. Il GPS è più preciso all’aperto e consuma più batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合は歩数から推定します。GPSは屋外でより正確ですが、バッテリー消費が増えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit gebruikt een schatting op basis van stappen. GPS is buiten nauwkeuriger en kost meer batterij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone używa szacunku na podstawie kroków. GPS jest dokładniejszy na zewnątrz i zużywa więcej baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado usa uma estimativa por passos. O GPS é mais preciso ao ar livre e gasta mais bateria."
          }
        }
      }
    },
